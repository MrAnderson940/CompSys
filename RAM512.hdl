// File name: projects/03/b/RAM512.hdl

/**
 * Memory of 512 registers, each 16 bit-wide. Out holds the value
 * stored at the memory location specified by address. If load==1, then 
 * the in value is loaded into the memory location specified by address 
 * (the loaded value will be emitted to out from the next time step onward).
 */

CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
    AddressSplit9bit(Address=address,MostSignificant=ms,LessSignifcant=ls);
    DMux8Way(in=load,sel=ms,a=a,b=b,c=c,d=d,e=e,f=f,g=g,h=h);

    RAM64(in=in,load=a,address=ls,out=ra);
    RAM64(in=in,load=b,address=ls,out=rb);
    RAM64(in=in,load=c,address=ls,out=rc);
    RAM64(in=in,load=d,address=ls,out=rd);
    RAM64(in=in,load=e,address=ls,out=re);
    RAM64(in=in,load=f,address=ls,out=rf);
    RAM64(in=in,load=g,address=ls,out=rg);
    RAM64(in=in,load=h,address=ls,out=rh);

    
    Mux8Way16(a=ra,b=rb,c=rc,d=rd,e=re,f=rf,g=rg,h=rh,sel=ms,out=out);
}