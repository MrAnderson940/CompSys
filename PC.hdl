// File name: projects/03/a/PC.hdl

/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    Or(a=reset,b=load,out=o1);
    Or(a=o1,b=inc,out=tload);
    Inc16(in=outh,out=incout);
    Mux16(a=outh,b=incout,sel=inc,out=selinc);
    Mux16(a=selinc,b=in,sel=load,out=selload);
    Mux16(a=selload,b=false,sel=reset,out=selreset);
    Register(in=selreset,load=tload,out=out,out=outh);
}
